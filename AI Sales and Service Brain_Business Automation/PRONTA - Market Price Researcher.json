    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst product = data['Product Name'];\nconst brand = data['Brand (if known)'] || '';\nconst quantity = data['Quantity Required'];\nconst category = data['Product Category'];\nconst specs = data['Additional Specifications'] || '';\n\n// Build multiple search queries\nconst brandText = brand ? `${brand} ` : '';\nconst specsText = specs ? ` ${specs}` : '';\n\nconst queries = [\n  `${brandText}${product} price Pakistan 2026`,\n  `${brandText}${product} price Lahore Pakistan`,\n  `${product} supplier Pakistan wholesale price`,\n  `${brandText}${product}${specsText} PKR price`\n];\n\nreturn [{\n  json: {\n    product,\n    brand,\n    quantity,\n    category,\n    specs,\n    queries,\n    searchQuery1: queries[0],\n    searchQuery2: queries[1],\n    searchQuery3: queries[2],\n    searchQuery4: queries[3],\n    timestamp: new Date().toLocaleString('en-PK', { timeZone: 'Asia/Karachi' })\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "81dca3dc-7074-4e6f-9989-ed99c60f7c60",
      "name": "Build Search Queries"
    },
    {
      "parameters": {
        "url": "https://serpapi.com/search.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "api_key",
