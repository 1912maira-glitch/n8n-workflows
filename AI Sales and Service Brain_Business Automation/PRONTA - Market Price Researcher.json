      "id": "7cdeca58-0f5a-472e-a7c2-f57d0e577f18",
      "name": "AI Price Analyst",
      "credentials": {
        "httpHeaderAuth": {
          "id": "muFl77YVPV6UGXQG",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst requestBody = {\n  model: \"llama-3.3-70b-versatile\",\n  max_tokens: 1000,\n  temperature: 0.3,\n  messages: [\n    {\n      role: \"system\",\n      content: `You are a market price analyst for PRONTA (Private) Limited, a Pakistani industrial supplier in Lahore. \n      Analyze the search results and provide a detailed price research report.\n      Always respond in this exact format:\n      \n      MARKET PRICE REPORT\n      ===================\n      Product: [name]\n      Brand: [brand]\n      Quantity: [qty]\n      \n      PRICE ANALYSIS:\n      • Estimated Market Price Range: PKR [min] - PKR [max]\n      • Average Market Price: PKR [avg]\n      • Recommended Buying Price: PKR [buy]\n      • Recommended Selling Price (15% margin): PKR [sell]\n      • Estimated Grand Total (for quantity): PKR [total]\n      \n      KEY FINDINGS:\n      • [finding 1]\n      • [finding 2]\n      • [finding 3]\n      \n      SOURCES FOUND:\n      • [source 1]\n      • [source 2]\n      \n      RECOMMENDATION:\n      [1-2 sentence recommendation for PRONTA sales rep]`\n    },\n    {\n      role: \"user\",\n      content: `Research product: ${data.product}\nBrand: ${data.brand || 'Any'}\nQuantity needed: ${data.quantity}\nCategory: ${data.category}\nSpecifications: ${data.specs || 'Standard'}\n\nSearch Results from Pakistani market:\n${data.searchResults}\n\nPrices found in search: ${data.pricesFound}\n\nPlease analyze and provide the market price report.`\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    ...data,\n    requestBody\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "d988bf57-05a7-4113-9331-ff467e0e3523",
      "name": "Build Price AI Request"
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ '🔍 **MARKET PRICE RESEARCH REPORT**\\n\\n📦 **Product:** ' + $('Build Search Queries').first().json.product + '\\n🏷️ **Brand:** ' + ($('Build Search Queries').first().json.brand || 'Any') + '\\n🔢 **Quantity:** ' + $('Build Search Queries').first().json.quantity + '\\n📂 **Category:** ' + $('Build Search Queries').first().json.category + '\\n🕐 **Researched At:** ' + $('Build Search Queries').first().json.timestamp + '\\n\\n━━━━━━━━━━━━━━━━━━━━━━\\n\\n' + $json.choices[0].message.content + '\\n\\n━━━━━━━━━━━━━━━━━━━━━━\\n_PRONTA AI Market Research System_' }}",
        "options": {}
