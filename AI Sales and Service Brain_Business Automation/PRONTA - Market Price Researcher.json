      ],
      "id": "de0916b2-7abe-4df8-9827-cfc25fe8ef20",
      "name": "Search Price 2"
    },
    {
      "parameters": {
        "jsCode": "// Get search results from both searches\nconst search1 = $('Search Price 1').first().json;\nconst search2 = $('Search Price 2').first().json;\nconst formData = $('Build Search Queries').first().json;\n\n// Extract organic results\nconst results1 = search1.organic_results || [];\nconst results2 = search2.organic_results || [];\nconst allResults = [...results1, ...results2];\n\n// Extract snippets and titles\nconst searchData = allResults.map(r => ({\n  title: r.title || '',\n  snippet: r.snippet || '',\n  link: r.link || '',\n  displayed_link: r.displayed_link || ''\n}));\n\n// Extract price mentions from snippets\nconst pricePattern = /(?:PKR|Rs\\.?|₨)\\s*[\\d,]+(?:\\.\\d+)?|\\d+(?:,\\d+)*(?:\\.\\d+)?\\s*(?:PKR|Rs\\.?|₨)/gi;\nconst prices = [];\n\nsearchData.forEach(r => {\n  const text = r.title + ' ' + r.snippet;\n  const matches = text.match(pricePattern) || [];\n  matches.forEach(p => prices.push(p));\n});\n\n// Format search results for AI\nconst formattedResults = searchData\n  .slice(0, 8)\n  .map((r, i) => `Result ${i+1}: ${r.title}\\n${r.snippet}\\nSource: ${r.displayed_link}`)\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    product: formData.product,\n    brand: formData.brand,\n    quantity: formData.quantity,\n    category: formData.category,\n    specs: formData.specs,\n    timestamp: formData.timestamp,\n    searchResults: formattedResults,\n    pricesFound: prices.join(', ') || 'No direct prices found in search',\n    totalResults: allResults.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "5e5e5e3f-8449-42ca-a114-9272e11fc815",
      "name": "Extract Price Data"
