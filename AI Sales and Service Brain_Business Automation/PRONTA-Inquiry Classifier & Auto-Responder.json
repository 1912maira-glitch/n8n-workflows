        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"max_tokens\": 1000,\n  \"temperature\": 0.1,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI assistant for an industrial supplier company in Pakistan. Classify the incoming email and return ONLY valid JSON, no other text, no markdown, no explanation.\\n\\nCategories: UPS_POWER, GENERATORS, RO_WATER, INDUSTRIAL_PARTS, SAFETY_PPE, CCTV_SECURITY, LIGHTING, TOOLS, FURNITURE, PACKAGING, COMPLAINT, OTHER\\n\\nReturn this exact JSON format:\\n{\\n  \\\"category\\\": \\\"CATEGORY_HERE\\\",\\n  \\\"intent\\\": \\\"INQUIRY or COMPLAINT or FOLLOW_UP or SPAM\\\",\\n  \\\"urgency\\\": \\\"LOW or MEDIUM or HIGH or CRITICAL\\\",\\n  \\\"buying_intent\\\": \\\"LOW or MEDIUM or HIGH\\\",\\n  \\\"summary\\\": \\\"one sentence of what client wants\\\",\\n  \\\"client_name\\\": \\\"extracted name or Unknown\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'From: ' + $json.from + '\\\\nSubject: ' + $json.subject + '\\\\nMessage: ' + ($json.text || $json.snippet || 'No content') }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
