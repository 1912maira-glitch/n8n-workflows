    {
      "parameters": {
        "jsCode": "const groqOutput = $input.first().json;\nconst emailData = $('Gmail Trigger').first().json;\n\nfunction extractEmailBody(emailJson) {\n  try {\n    function findTextPart(parts) {\n      if (!parts) return null;\n      for (const part of parts) {\n        if (part.mimeType === 'text/plain' && part.body?.data) {\n          return Buffer.from(part.body.data, 'base64url').toString('utf-8');\n        }\n        if (part.parts) {\n          const found = findTextPart(part.parts);\n          if (found) return found;\n        }\n      }\n      return null;\n    }\n    const fromParts = findTextPart(emailJson.payload?.parts);\n    if (fromParts && fromParts.length > 10) return fromParts;\n    if (emailJson.payload?.body?.data) {\n      return Buffer.from(emailJson.payload.body.data, 'base64url').toString('utf-8');\n    }\n    if (emailJson.text && emailJson.text.length > 10) return emailJson.text;\n  } catch(e) {}\n  return emailJson.snippet || 'No content';\n}\n\n// Extract from and subject from Gmail headers\nfunction extractHeader(emailJson, headerName) {\n  try {\n    const headers = emailJson.payload?.headers || [];\n    const header = headers.find(h => h.name.toLowerCase() === headerName.toLowerCase());\n    return header ? header.value : '';\n  } catch(e) {\n    return '';\n  }\n}\n\nconst emailBody = extractEmailBody(emailData);\nconst fromHeader = extractHeader(emailData, 'From') || emailData.from || '';\nconst subjectHeader = extractHeader(emailData, 'Subject') || emailData.subject || '';\n\nconst rawContent = groqOutput.choices[0].message.content;\nconst cleaned = rawContent\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet classification;\ntry {\n  classification = JSON.parse(cleaned);\n} catch (e) {\n  classification = {\n    category: \"OTHER\",\n    intent: \"INQUIRY\",\n    urgency: \"LOW\",\n    buying_intent: \"LOW\",\n    summary: \"Could not parse AI response\",\n    client_name: \"Unknown\"\n  };\n}\n\nreturn [{\n  json: {\n    category: classification.category,\n    intent: classification.intent,\n    urgency: classification.urgency,\n    buying_intent: classification.buying_intent,\n    summary: classification.summary,\n    client_name: classification.client_name,\n   from: emailData.From || emailData.from || '',\n  subject: emailData.Subject || emailData.subject || '',\n    text: emailBody,\n    date: emailData.internalDate,\n    threadId: emailData.threadId,\n    messageId: emailData.id\n  }\n}];"
      },
