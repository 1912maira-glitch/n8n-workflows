        "subject": "={{ '✅ Complaint Received — Ticket ' + $('Log Complaint').first().json[' Ticket ID'] }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin:auto; background:#ffffff; border:1px solid #ddd;\">\n  <!-- Header -->\n  <div style=\"background:#1A3A6B; padding:20px;\">\n    <h2 style=\"margin:0; color:white;\">PRONTA (Private) Limited</h2>\n    <p style=\"margin:5px 0 0; color:#D6EAF8;\">Complaint Management System</p>\n  </div>\n  <!-- Body -->\n  <div style=\"padding:25px; background:#F8F9FA;\">\n    <p>Dear <strong>{{ $('Log Complaint').first().json['Client Name'] }}</strong>,</p>\n    <p>Thank you for contacting <strong>PRONTA (Private) Limited</strong>. Your complaint has been successfully registered in our Complaint Management System.</p>\n\n    <table style=\"width:100%; border-collapse:collapse; margin-top:20px;\">\n      <tr style=\"background:#1A3A6B; color:white;\">\n        <td style=\"padding:10px;\"><strong>Ticket ID</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json[' Ticket ID'] }}</td>\n      </tr>\n      <tr style=\"background:#EEF2FF;\">\n        <td style=\"padding:10px;\"><strong>Category</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json['Category'] }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px;\"><strong>Urgency</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json['Urgency'] }}</td>\n      </tr>\n      <tr style=\"background:#EEF2FF;\">\n        <td style=\"padding:10px;\"><strong>Issue Summary</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json['Summary'] }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px;\"><strong>Suggested Action</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json['Suggested Action'] }}</td>\n      </tr>\n      <tr style=\"background:#EEF2FF;\">\n        <td style=\"padding:10px;\"><strong>Estimated Resolution</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json['Estimated Hours'] }} Hours</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px;\"><strong>Assigned Technician</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json['Assigned Tech'] }}</td>\n      </tr>\n      <tr style=\"background:#EEF2FF;\">\n        <td style=\"padding:10px;\"><strong>Complaint Received</strong></td>\n        <td style=\"padding:10px;\">{{ $('Log Complaint').first().json['Timestamp'] }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px;\"><strong>Status</strong></td>\n        <td style=\"padding:10px; color:#E67E22;\"><strong>{{ $('Log Complaint').first().json['Status'] }}</strong></td>\n      </tr>\n    </table>\n\n    <div style=\"margin-top:25px; padding:15px; background:#E8F8F5; border-left:5px solid #27AE60;\">\n      <strong>✅ What happens next?</strong><br><br>\n      • Our support engineers have been notified.<br>\n      • Your complaint has been prioritized according to its urgency.<br>\n      • A technician will contact you within <strong>{{ $('Log Complaint').first().json['Estimated Hours'] }} hours</strong>.<br>\n      • You will receive updates as your complaint progresses.\n    </div>\n\n    <p style=\"margin-top:25px;\">\n      Please keep your Ticket ID <strong>{{ $('Log Complaint').first().json[' Ticket ID'] }}</strong> for future communication",
