    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"max_tokens\": 1000,\n  \"temperature\": 0.1,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a complaint triage AI for PRONTA (Pvt) Ltd, a Pakistani industrial supplier. Analyze the complaint and return ONLY valid JSON, no other text, no markdown.\\n\\nReturn this exact format:\\n{\\n  \\\"urgency\\\": \\\"CRITICAL or HIGH or MEDIUM or LOW\\\",\\n  \\\"category\\\": \\\"GENERATOR or UPS or RO_PLANT or AC or CCTV or ELECTRICAL or OTHER\\\",\\n  \\\"summary\\\": \\\"one sentence plain English summary\\\",\\n  \\\"suggested_action\\\": \\\"what technician should do\\\",\\n  \\\"estimated_hours\\\": 2,\\n  \\\"client_name\\\": \\\"extracted name or Unknown\\\"\\n}\\n\\nUrgency rules:\\nCRITICAL = equipment completely down, business stopped, factory halted\\nHIGH = major problem, urgent but partially working\\nMEDIUM = inconvenience, working poorly\\nLOW = minor issue or general feedback\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ ($json['Client Name'] ? 'Client: ' + $json['Client Name'] : 'From: ' + $json.From) + '\\\\nComplaint: ' + ($json['Complaint Description'] || $json.snippet || $json.text || '') + '\\\\nCategory: ' + ($json['Product Category'] || 'Unknown') }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        416,
        48
      ],
      "id": "b045c030-569c-4cd1-8982-4c994d5521e8",
      "name": "Groq AI Triage",
      "credentials": {
        "httpHeaderAuth": {
          "id": "muFl77YVPV6UGXQG",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const groqOutput = $input.first().json;\nconst rawContent = groqOutput.choices[0].message.content;\n\n// Clean Groq response\nconst cleaned = rawContent\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Parse JSON safely\nlet triage;\ntry {\n  triage = JSON.parse(cleaned);\n} catch (e) {\n  triage = {\n    urgency: \"MEDIUM\",\n    category: \"OTHER\",\n    summary: \"Could not parse complaint\",\n    suggested_action: \"Contact client directly\",\n    estimated_hours: 4,\n    client_name: \"Unknown\"\n  };\n}\n\n// Get original merged data\nconst original = $('Merge Complaints').first().json;\n\n// ------------------------------\n// Determine source channel\n// ------------------------------\nconst channel = original['Client Name'] ? 'PHONE' : 'EMAIL';\n\n// ------------------------------\n// Client Name\n// ------------------------------\nconst clientName =\n  triage.client_name && triage.client_name !== 'Unknown'\n    ? triage.client_name\n    : (original['Client Name'] || 'Unknown');\n\n// ------------------------------\n// Client Phone\n// ------------------------------\nconst clientPhone =\n  original['Client WhatsApp Number'] ||\n  original['Phone'] ||\n  original['phone'] ||\n  '';\n\n// ------------------------------\n// Client Email\n// ------------------------------\nconst clientEmail =\n  original[\"Client Email\"] ||\n  original.Email ||\n  original.email ||\n  original[\"Email Address\"] ||\n  \"\";\n\n// ------------------------------\n// Complaint Text\n// ------------------------------\nconst complaintText =\n  original['Complaint Description'] ||\n  original.snippet ||\n  original.text ||\n  '';\n\n// ------------------------------\n// Generate Ticket ID\n// ------------------------------\nconst now = new Date();\n\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst day = String(now.getDate()).padStart(2, '0');\nconst random = Math.floor(Math.random() * 9000) + 1000;\n\nconst ticketId = `TKT-${year}${month}${day}-${random}`;\n\n// ------------------------------\n// Timestamp\n// ------------------------------\nconst timestamp = now.toLocaleString('en-PK', {\n  timeZone: 'Asia/Karachi'\n});\nconsole.log(original[\"Client Email\"]);\nconsole.log(clientEmail);\n// ------------------------------\n// Return Final Object\n// ------------------------------\nreturn [{\n  json: {\n    ticketId,\n    timestamp,\n    clientName,\n    clientPhone,\n    clientEmail,   // <-- This line must be here\n    channel,\n    category: triage.category,\n    urgency: triage.urgency,\n    summary: triage.summary,\n    suggestedAction: triage.suggested_action,\n    estimatedHours: triage.estimated_hours,\n    complaintText,\n    status: \"OPEN\",\n    assignedTech: \"PENDING\"\n  }\n}];"
      },
