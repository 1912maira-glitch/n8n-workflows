    {
      "parameters": {
        "jsCode": "const contracts = $input.all();\nconst now = new Date();\nconst remindersToSend = [];\n\nfor (const row of contracts) {\n  const data = row.json;\n  \n  // Skip if not active\n  const status = data['Status'] || '';\n  if (!['ACTIVE', 'active', 'Active'].includes(status)) continue;\n  \n  // Skip if no expiry date\n  const expiryStr = data['Contract Expiry'];\n  if (!expiryStr) continue;\n  \n  // Skip if no email\n  const email = data['Client Email'] || '';\n  if (!email.includes('@')) continue;\n  \n  // Parse expiry date DD/MM/YYYY\n  let expiryDate;\n  try {\n    const parts = expiryStr.split('/');\n    if (parts.length === 3) {\n      expiryDate = new Date(`${parts[2]}-${parts[1]}-${parts[0]}`);\n    } else {\n      expiryDate = new Date(expiryStr);\n    }\n  } catch(e) {\n    continue;\n  }\n  \n  if (isNaN(expiryDate.getTime())) continue;\n  \n  // Calculate days until expiry\n  const daysUntilExpiry = Math.ceil((expiryDate - now) / (1000 * 60 * 60 * 24));\n  \n  // Determine reminder type\n  let reminderType = null;\n  let urgencyLevel = null;\n  let urgencyColor = null;\n  \n  if (daysUntilExpiry <= 0) {\n    reminderType = 'EXPIRED';\n    urgencyLevel = 'CRITICAL';\n    urgencyColor = '🔴';\n  } else if (daysUntilExpiry <= 7) {\n    reminderType = 'URGENT';\n    urgencyLevel = 'HIGH';\n    urgencyColor = '🟠';\n  } else if (daysUntilExpiry <= 30) {\n    reminderType = 'REMINDER_30';\n    urgencyLevel = 'MEDIUM';\n    urgencyColor = '🟡';\n  } else if (daysUntilExpiry <= 60) {\n    reminderType = 'REMINDER_60';\n    urgencyLevel = 'LOW';\n    urgencyColor = '🟢';\n  }\n  \n  if (!reminderType) continue;\n  \n  // Format expiry date nicely\n  const expiryFormatted = expiryDate.toLocaleDateString('en-PK', {\n    day: '2-digit',\n    month: 'long',\n    year: 'numeric'\n  });\n  \n  remindersToSend.push({\n    json: {\n      clientName: data['Client Name'],\n      clientEmail: email,\n      clientPhone: data['Client Phone'] || '',\n      product: data['Product'],\n      contractStart: data['Contract Start'],\n      contractExpiry: expiryStr,\n      contractExpiryFormatted: expiryFormatted,\n      annualValue: data['Annual Value (PKR)'] || '0',\n      notes: data['Notes'] || '',\n      daysUntilExpiry,\n      reminderType,\n      urgencyLevel,\n      urgencyColor,\n      rowNumber: data['row_number'] || data['rowIndex']\n    }\n  });\n}\n\nif (remindersToSend.length === 0) {\n  return [{ json: { noReminders: true, message: 'No AMC contracts need attention today' } }];\n}\n\nreturn remindersToSend;"
      },
