    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst urgencyMessages = {\n  'EXPIRED': 'Their contract has EXPIRED today. Be urgent but professional. Offer immediate renewal.',\n  'URGENT': `Contract expires in ${data.daysUntilExpiry} days. Be urgent. Mention service continuity risk.`,\n  'REMINDER_30': `Contract expires in ${data.daysUntilExpiry} days. Be professional. Offer renewal options.`,\n  'REMINDER_60': `Contract expires in ${data.daysUntilExpiry} days. Be warm and proactive. Mention early renewal benefits.`\n};\n\nconst requestBody = {\n  model: \"llama-3.3-70b-versatile\",\n  max_tokens: 500,\n  temperature: 0.5,\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a professional account manager for PRONTA (Private) Limited, a Pakistani industrial supplier. Write AMC renewal reminder emails. Be professional, warm, and persuasive. Never sound desperate. Always mention the value of continuing the service relationship. Keep emails under 150 words. Return ONLY the email body, no subject line.\"\n    },\n    {\n      role: \"user\",\n      content: `Write an AMC renewal email for:\nClient: ${data.clientName}\nProduct/Service: ${data.product}\nContract Expiry: ${data.contractExpiryFormatted}\nAnnual Value: PKR ${parseInt(data.annualValue).toLocaleString()}\nSituation: ${urgencyMessages[data.reminderType]}\nNotes: ${data.notes}`\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    ...data,\n    requestBody\n  }\n}];"
      },
