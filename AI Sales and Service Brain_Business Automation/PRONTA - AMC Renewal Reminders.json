        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 650px; margin: auto;\">    <!-- Header -->   <div style=\"background: #ffffff; padding: 25px; border-radius: 5px 5px 0 0; border-bottom: 4px solid #1A3A6B;\">     <img src=\"https://drive.google.com/uc?export=view&id=1TcJPHyV2lamgz34iecF3taD5BLmN9D6c\"           alt=\"PRONTA\" style=\"height: 55px; margin-bottom: 10px;\"/>     <p style=\"color: #555; margin: 0; font-size: 12px;\">Sourcing Redefined</p>   </div>    <!-- Urgency Banner -->   <div style=\"background: {{ $('Check Expiry Dates').first().json.reminderType === 'EXPIRED' ? '#E74C3C' : $('Check Expiry Dates').first().json.reminderType === 'URGENT' ? '#E67E22' : '#1A3A6B' }}; padding: 15px; text-align: center;\">     <h2 style=\"color: white; margin: 0; font-size: 18px;\">       {{ $('Check Expiry Dates').first().json.urgencyColor }}        {{ $('Check Expiry Dates').first().json.reminderType === 'EXPIRED' ? 'CONTRACT EXPIRED' : $('Check Expiry Dates').first().json.reminderType === 'URGENT' ? 'URGENT — Expires in ' + $('Check Expiry Dates').first().json.daysUntilExpiry + ' Days' : 'AMC Renewal Reminder — ' + $('Check Expiry Dates').first().json.daysUntilExpiry + ' Days Remaining' }}     </h2>   </div>    <!-- Body -->   <div style=\"background: #f5f7fa; padding: 25px;\">     <p>Dear <strong>{{ $('Check Expiry Dates').first().json.clientName }}</strong>,</p>      {{ $json.choices[0].message.content }}      <!-- Contract Details -->     <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">       <tr style=\"background: #1A3A6B; color: white;\">         <td style=\"padding: 10px;\"><strong>Contract Details</strong></td>         <td style=\"padding: 10px;\"></td>       </tr>       <tr style=\"background: #EEF2FF;\">         <td style=\"padding: 10px;\"><strong>Service</strong></td>         <td style=\"padding: 10px;\">{{ $('Check Expiry Dates').first().json.product }}</td>       </tr>       <tr>         <td style=\"padding: 10px;\"><strong>Expiry Date</strong></td>         <td style=\"padding: 10px; color: #E74C3C;\"><strong>{{ $('Check Expiry Dates').first().json.contractExpiryFormatted }}</strong></td>       </tr>       <tr style=\"background: #EEF2FF;\">         <td style=\"padding: 10px;\"><strong>Days Remaining</strong></td>         <td style=\"padding: 10px; color: #E67E22;\"><strong>{{ $('Check Expiry Dates').first().json.daysUntilExpiry }} days</strong></td>       </tr>       <tr>         <td style=\"padding: 10px;\"><strong>Annual Value</strong></td>         <td style=\"padding: 10px;\">PKR {{ parseInt($('Check Expiry Dates').first().json.annualValue).toLocaleString() }}</td>       </tr>     </table>      <!-- CTA Box -->     <div style=\"background: #E8F5E9; border-left: 5px solid #27AE60; padding: 15px; border-radius: 0 5px 5px 0; margin: 20px 0;\">       <strong>✅ Renew Your Contract Today:</strong><br/><br/>       📞 Call us: <strong>+92 321 65 56 109</strong><br/>       📧 Email: <strong>sales@prontapk.com</strong><br/>       💬 WhatsApp: <strong>+92 321 65 56 109</strong>     </div>      <p>Best Regards,<br/>     <strong>PRONTA Account Management Team</strong><br/>     PRONTA (Private) Limited</p>   </div>    <!-- Footer -->   <div style=\"background: #1A3A6B; padding: 15px; border-radius: 0 0 5px 5px; text-align: center;\">     <p style=\"color: #A9CCE3; margin: 0; font-size: 12px;\">PRONTA (Private) Limited — Sourcing Redefined</p>     <p style=\"color: #A9CCE3; margin: 5px 0 0; font-size: 12px;\">sales@prontapk.com | www.prontapk.com | +92 321 65 56 109</p>   </div>  </div>",
