        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"max_tokens\": 500,\n  \"temperature\": 0.7,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a professional sales follow-up email writer for PRONTA (Private) Limited, a Pakistani industrial supplier. Write short, warm, professional follow-up emails. Never sound desperate. Always end with a clear call to action. Return ONLY the email body text, no subject line, no greeting, just the body paragraphs.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'Write a ' + $json.followUpType + ' follow-up email for: ' + '\\\\nClient: ' + $json.clientName + '\\\\nThey inquired about: ' + $json.category + '\\\\nOriginal inquiry: ' + $json.summary + '\\\\nFollow-up number: ' + ($json.followUpCount + 1) + '\\\\n\\\\nIf FIRST follow-up: be warm and helpful, offer assistance.\\\\nIf FINAL follow-up: mention this is last follow-up, offer a special priority service.' }}\"\n    }\n  ]\n}",
        "options": {}
