        "subject": "={{ $('Filter Leads').first().json.followUpType === 'FIRST' ? '👋 Following up on your inquiry — ' + $('Filter Leads').first().json.category : '⏰ Last follow-up — PRONTA (Pvt) Ltd' }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; padding: 20px;\">    <div style=\"background: #1A3A6B; padding: 20px; border-radius: 5px 5px 0 0;\">     <h2 style=\"color: white; margin: 0;\">PRONTA (Private) Limited</h2>     <p style=\"color: #A9CCE3; margin: 5px 0 0;\">Sourcing Redefined</p>   </div>    <div style=\"background: #f5f7fa; padding: 25px; border-radius: 0 0 5px 5px;\">     <p>Dear <strong>{{ $('Filter Leads').first().json.clientName }}</strong>,</p>      {{ $('AI Follow-up Writer').first().json.choices[0].message.content }}      <div style=\"margin-top: 20px; padding: 15px; background: #EEF2FF; border-left: 4px solid #1A3A6B; border-radius: 0 5px 5px 0;\">       <strong>📞 Get in touch with us:</strong><br/><br/>       📱 WhatsApp: +92 321 65 56 109<br/>       📧 Email: sales@prontapk.com<br/>       🌐 Website: www.prontapk.com<br/>       📍 Office # F-03, Nazir Center, 146 Ferozpur Road, Lahore     </div>      <p style=\"margin-top: 20px;\">Best Regards,<br/>     <strong>PRONTA Sales Team</strong><br/>     PRONTA (Private) Limited</p>   </div>  </div>",
        "options": {}
