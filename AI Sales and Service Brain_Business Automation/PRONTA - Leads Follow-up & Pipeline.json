    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst now = new Date();\nconst leadsToFollowUp = [];\n\nfor (const row of rows) {\n  const data = row.json;\n  \n  // Skip if not an inquiry\n  if (data['Intent'] !== 'INQUIRY') continue;\n  \n  // Skip if already handled\n  const status = data['Status'] || '';\n  if (['QUOTED', 'RESOLVED', 'COLD', 'CONVERTED'].includes(status)) continue;\n  \n  // Skip if follow up count is 2 or more\n  const followUpCount = parseInt(data['Follow Up Count'] || 0);\n  if (followUpCount >= 2) continue;\n  \n  // Get email from multiple possible fields\n  let email = data['From'] || data['from'] || data['Client Email'] || '';\n  \n  // Extract clean email if it has name format\n  if (email.includes('<')) {\n    email = email.split('<')[1].replace('>', '').trim();\n  } else {\n    email = email.trim();\n  }\n  \n  // Skip if no valid email\n  if (!email.includes('@')) continue;\n  \n  // Get timestamp\n  const timestamp = data['Timestamp'];\n  if (!timestamp) continue;\n  \n  // Parse Pakistani date format: \"24/06/2026, 12:46:59 am\"\n  let inquiryDate;\n  try {\n    const parts = timestamp.split(', ');\n    const dateParts = parts[0].split('/');\n    const day = dateParts[0];\n    const month = dateParts[1];\n    const year = dateParts[2];\n    \n    // Build US format: MM/DD/YYYY HH:MM:SS am/pm\n    const usDateStr = `${month}/${day}/${year} ${parts[1]}`;\n    inquiryDate = new Date(usDateStr);\n    \n    // If still invalid try direct\n    if (isNaN(inquiryDate.getTime())) {\n      inquiryDate = new Date(timestamp);\n    }\n  } catch(e) {\n    inquiryDate = new Date(timestamp);\n  }\n  \n  // Skip if date is still invalid\n  if (isNaN(inquiryDate.getTime())) continue;\n  \n  const hoursDiff = (now - inquiryDate) / (1000 * 60 * 60);\n  \n  // ✅ PRODUCTION — First follow-up after 24 hours\n  if (followUpCount === 0 && hoursDiff >= 24) {\n    leadsToFollowUp.push({\n      json: {\n        rowNumber: data['row_number'] || data['rowIndex'],\n        clientName: data['Client Name'] || 'Valued Client',\n        email: email,\n        category: data['Category'] || 'your inquiry',\n        summary: data['Summary'] || '',\n        subject: data['Subject'] || '',\n        followUpCount: 0,\n        followUpType: 'FIRST',\n        timestamp: timestamp,\n        hoursDiff: Math.round(hoursDiff)\n      }\n    });\n  }\n  \n  // ✅ PRODUCTION — Second follow-up after 48 hours\n  if (followUpCount === 1 && hoursDiff >= 48) {\n    leadsToFollowUp.push({\n      json: {\n        rowNumber: data['row_number'] || data['rowIndex'],\n        clientName: data['Client Name'] || 'Valued Client',\n        email: email,\n        category: data['Category'] || 'your inquiry',\n        summary: data['Summary'] || '',\n        subject: data['Subject'] || '',\n        followUpCount: 1,\n        followUpType: 'FINAL',\n        timestamp: timestamp,\n        hoursDiff: Math.round(hoursDiff)\n      }\n    });\n  }\n}\n\nif (leadsToFollowUp.length === 0) {\n  return [{ json: { noLeads: true, message: 'No leads need follow-up today' } }];\n}\n\nreturn leadsToFollowUp;"
      },
